# Python environments, builds, and caches

# Credentials
.secrets/
token.py

# Raw data
/io/real_data/

# when using uv sync it will create .venv and install project dependencies
.venv/

# Include the TabPFN source copies and their required assets.
#!/vendor/
#!/vendor/**

# Ignore Python caches, including caches generated inside vendor.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Notebook checkpoints and test/tool caches are generated automatically.
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.vscode/
catboost_info/

# Generated warnings and worker logs, including older output layouts.
/io/**/warnings/
/io/**/*.warnings.json
/io/**/*.warnings.log
/io/**/*.warnings.workers/
/io/**/worker_download/
/io/**/*.log
/io/**/*.tmp

# Generated report plots and tables.
/io/**/plots/
/io/**/tables/

# Data-cleaning notes and predictor lists are tracked.
tests/
docs/physionet/
docs/quadro

# archiv past version
benchmark-tabpfn-medical/